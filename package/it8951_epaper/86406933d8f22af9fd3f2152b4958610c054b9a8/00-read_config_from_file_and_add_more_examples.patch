diff --git a/Raspberry/lib/Config/FILE_gpiod.c b/Raspberry/lib/Config/FILE_gpiod.c
new file mode 100644
index 0000000..f8ddda8
--- /dev/null
+++ b/Raspberry/lib/Config/FILE_gpiod.c
@@ -0,0 +1,310 @@
+/*****************************************************************************
+* | File        :   GPIOD.c
+* | Author      :   Waveshare team
+* | Function    :   Drive GPIO
+* | Info        :   Read and write gpio
+*----------------
+* |	This version:   V1.0
+* | Date        :   2023-11-15
+* | Info        :   Basic version
+*
+#
+# Permission is hereby granted, free of charge, to any person obtaining a copy
+# of this software and associated documnetation files (the "Software"), to deal
+# GPIOD_IN the Software without restriction, including without limitation the
+rights # to use, copy, modify, merge, publish, distribute, sublicense, and/or
+sell # copies of the Software, and to permit persons to  whom the Software is #
+furished to do so, subject to the folGPIOD_LOWing conditions:
+#
+# The above copyright notice and this permission notice shall be included
+GPIOD_IN # all copies or substantial portions of the Software.
+#
+# THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
+# IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+# FITNESS OR A PARTICULAR PURPOSE AND NONINFRINGEMENT. GPIOD_IN NO EVENT SHALL
+THE # AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER #
+LIABILITY WHETHER GPIOD_IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
+FROM, # GPIOD_OUT OF OR GPIOD_IN CONNECTION WITH THE SOFTWARE OR THE USE OR
+OTHER DEALINGS GPIOD_IN # THE SOFTWARE.
+#
+******************************************************************************/
+#include <fcntl.h>
+#include <gpiod.h>
+#include <linux/limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+#include "DEV_Config.h"
+
+#define GPIOD_CONFIG_DEFAULT_PATH "/etc/it8951_epaper/gpiod.conf"
+
+struct GpiodMapping {
+  char mapping_name[128];
+  struct gpiod_chip *chip;
+  char chip_path[PATH_MAX];
+  int pin;
+};
+
+static const char *pin_to_name_map[] = {
+    [EPD_RST_PIN] = "RST",
+    [EPD_BUSY_PIN] = "BSY",
+    [EPD_CS_PIN] = "CS",
+};
+
+static struct GpiodMapping gpio_mappings[EPD_MAX_PIN];
+static struct gpiod_line *gpioline;
+static int ret;
+
+static int GPIOD_Mapping_init(const struct GpiodMapping *mapping);
+
+/*
+   Import pin mapping from file.
+   For example following file:
+     CS  = /dev/gpiochip2 5
+     BSY = /dev/gpiochip3 2
+     RST = /dev/gpiochip4 3
+
+   Will become:
+     CS is assigned to pin 5 from /dev/gpiochip2
+     BSY is assigned to pin 2 from /dev/gpiochip3
+     RST is assigned to pin 3 from /dev/gpiochip4
+ */
+int GPIOD_Export() {
+  static struct GpiodMapping local_gpio_mappings[EPD_MAX_PIN];
+  char config_field_chip[PATH_MAX];
+  char config_field_name[128];
+  int config_field_pin;
+  FILE *config_file;
+  char *config_path;
+  int ret;
+
+  config_path = getenv("GPIOD_CONFIG_PATH");
+  if (!config_path) {
+    config_path = GPIOD_CONFIG_DEFAULT_PATH;
+  }
+
+  config_file = fopen(config_path, "r");
+  if (!config_file) {
+    perror("fopen");
+    goto error_out;
+  }
+
+  memset(local_gpio_mappings, 0, sizeof(local_gpio_mappings));
+
+  int idx = 0;
+  for (; idx < sizeof(local_gpio_mappings) / sizeof(struct GpiodMapping);
+       idx++) {
+    ret = fscanf(config_file, "%s = %s %d", config_field_name,
+                 config_field_chip, &config_field_pin);
+
+    if (ret != 3) {
+      break;
+    }
+
+    strcpy(local_gpio_mappings[idx].mapping_name, config_field_name);
+    strcpy(local_gpio_mappings[idx].chip_path, config_field_chip);
+    local_gpio_mappings[idx].pin = config_field_pin;
+    printf("Found GPIOD mapping: name=%s, chip_path=%s, pin=%d\n",
+           config_field_name, config_field_chip, config_field_pin);
+  }
+
+  if (idx != 3) {
+    printf("idx=%d\n", idx);
+    errno = EINVAL;
+    puts("Invalid config content");
+    goto error_file_cleanup;
+  }
+
+  for (int mapping_idx = 0; mapping_idx < idx; mapping_idx++) {
+    ret = GPIOD_Mapping_init(&local_gpio_mappings[mapping_idx]);
+    if (ret != 0) {
+      printf("ret=%d\n", ret);
+      puts("Invalid config content");
+      goto error_file_cleanup;
+    }
+  }
+
+  printf("idx=%d\n", idx);
+
+  return 0;
+
+error_file_cleanup:
+  fclose(config_file);
+error_out:
+  return errno;
+}
+
+static int GPIOD_Mapping_init(const struct GpiodMapping *new_mapping) {
+  // Add mapping under proper idx
+  struct GpiodMapping *mapping = NULL;
+  bool is_mapping_valid = false;
+
+  for (int idx = 0; idx < sizeof(pin_to_name_map) / sizeof(char *); idx++) {
+    if (pin_to_name_map[idx] &&
+        strcmp(new_mapping->mapping_name, pin_to_name_map[idx]) == 0) {
+      is_mapping_valid = true;
+      mapping = &gpio_mappings[idx];
+      memcpy(mapping, new_mapping, sizeof(struct GpiodMapping));
+      break;
+    }
+  }
+
+  if (!is_mapping_valid) {
+    GPIOD_Debug("Mapping is not valid: %s\n", new_mapping->mapping_name);
+    return EINVAL;
+  }
+
+  // Check if chip is already open
+  struct gpiod_chip *chip = NULL;
+  for (int idx = 0; idx < sizeof(gpio_mappings) / sizeof(struct GpiodMapping);
+       idx++) {
+    if (strcmp(mapping->chip_path, gpio_mappings[idx].chip_path) == 0 &&
+        gpio_mappings[idx].chip) {
+      chip = gpio_mappings[idx].chip;
+      break;
+    }
+  }
+
+  // Open chip
+  if (!chip) {
+    mapping->chip = gpiod_chip_open(mapping->chip_path);
+    if (mapping->chip == NULL) {
+      GPIOD_Debug("gpiod_chip_open failed\n");
+      return -1;
+    }
+  } else {
+    mapping->chip = chip;
+  }
+
+  return 0;
+};
+
+static struct gpiod_chip *GPIOD_Chip(int Pin) {
+  const struct GpiodMapping *mapping;
+  if (Pin >= (sizeof(gpio_mappings) / sizeof(struct GpiodMapping))) {
+    GPIOD_Debug("INVALID GPIOCHIP\n");
+    return NULL;
+  }
+
+  mapping = &gpio_mappings[Pin];
+
+  return mapping->chip;
+}
+
+static int GPIOD_Pin(int Pin) {
+  const struct GpiodMapping *mapping;
+  if (Pin >= (sizeof(gpio_mappings) / sizeof(struct GpiodMapping))) {
+    GPIOD_Debug("INVALID GPIOCHIP\n");
+    return -1;
+  }
+
+  mapping = &gpio_mappings[Pin];
+
+  return mapping->pin;
+}
+
+static struct gpiod_line *GPIOD_Line(int Pin) {
+  return gpiod_chip_get_line(GPIOD_Chip(Pin), GPIOD_Pin(Pin));
+}
+
+int GPIOD_Unexport(int Pin) {
+  struct gpiod_chip *chip = NULL;
+
+  gpioline = GPIOD_Line(Pin);
+  if (gpioline == NULL) {
+    GPIOD_Debug("Export Failed: No gpioline for %s\n", pin_to_name_map[Pin]);
+  } else {
+    gpiod_line_release(gpioline);
+  }
+
+  struct GpiodMapping *gpio_mapping = &gpio_mappings[Pin];
+  if (gpio_mapping->chip) {
+    chip = gpio_mapping->chip;
+    for (int idx2 = 0;
+         idx2 < sizeof(gpio_mappings) / sizeof(struct GpiodMapping); idx2++) {
+      if (gpio_mappings[idx2].chip == chip) {
+        gpio_mappings[idx2].chip = NULL;
+      }
+    }
+  }
+
+  GPIOD_Debug("Unexport: Pin%d\r\n", Pin);
+
+  return 0;
+}
+
+int GPIOD_Unexport_GPIO(void) {
+  if (gpioline) {
+    gpiod_line_release(gpioline);
+    gpioline = NULL;
+  }
+
+
+  for (int idx = 0; idx < EPD_MAX_PIN; idx++) {
+    GPIOD_Unexport(idx);
+  }
+  
+  memset(gpio_mappings, 0, sizeof(gpio_mappings));
+
+  return 0;
+}
+
+int GPIOD_Direction(int Pin, int Dir) {
+  gpioline = GPIOD_Line(Pin);
+  if (gpioline == NULL) {
+    GPIOD_Debug("Export Failed: Pin%d\n", Pin);
+    return -1;
+  }
+
+  if (Dir == GPIOD_IN) {
+    ret = gpiod_line_request_input(gpioline, "gpio");
+    if (ret != 0) {
+      GPIOD_Debug("Export Failed: Pin%d\n", Pin);
+      return -1;
+    }
+    GPIOD_Debug("Pin%d:intput\r\n", Pin);
+  } else {
+    ret = gpiod_line_request_output(gpioline, "gpio", 0);
+    if (ret != 0) {
+      GPIOD_Debug("Export Failed: Pin%d\n", Pin);
+      return -1;
+    }
+    GPIOD_Debug("Pin%d:Output\r\n", Pin);
+  }
+  return 0;
+}
+
+int GPIOD_Read(int Pin) {
+  gpioline = GPIOD_Line(Pin);
+  if (gpioline == NULL) {
+    GPIOD_Debug("Export Failed: Pin%d\n", Pin);
+    return -1;
+  }
+
+  ret = gpiod_line_get_value(gpioline);
+  if (ret < 0) {
+    GPIOD_Debug("failed to read value!\n");
+    return -1;
+  }
+
+  return (ret);
+}
+
+int GPIOD_Write(int Pin, int value) {
+  gpioline = GPIOD_Line(Pin);
+  if (gpioline == NULL) {
+    GPIOD_Debug("Export Failed: Pin%d\n", Pin);
+    return -1;
+  }
+
+  ret = gpiod_line_set_value(gpioline, value);
+  if (ret != 0) {
+    GPIOD_Debug("failed to write value! : Pin%d\n", Pin);
+    return -1;
+  }
+  return 0;
+}
