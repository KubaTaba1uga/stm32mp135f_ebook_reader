+/******************************************************************************
+function: Change direction of display, Called after Paint_NewImage()
+parameter:
+    mode: display mode
+******************************************************************************/
+static void Epd_Mode(int mode)
+{
+	if(mode == 3) {
+		Paint_SetRotate(ROTATE_0);
+		Paint_SetMirroring(MIRROR_NONE);
+		isColor = 1;
+	}else if(mode == 2) {
+		Paint_SetRotate(ROTATE_0);
+		Paint_SetMirroring(MIRROR_HORIZONTAL);
+	}else if(mode == 1) {
+		Paint_SetRotate(ROTATE_0);
+		Paint_SetMirroring(MIRROR_HORIZONTAL);
+	}else {
+		Paint_SetRotate(ROTATE_0);
+		Paint_SetMirroring(MIRROR_NONE);
+	}
+}
